node_modules
dist
build
.DS_Store
Thumbs.db

# Secrets — never commit
.env
.env.*
!.env.example

# Rendered output (videos, stills, frames)
out
renders

# TTS cache: generated audio, alignment, local ledger of paid calls
cache

# Logs and temp
*.log
npm-debug.log*
tmp
.cache

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Claude Code personal settings (project skills in .claude/skills are committed)
.claude/settings.local.json

# Python virtualenvs
.venv
**/.venv
__pycache__

# Episode media (voice clones, large binaries): keep metadata/scripts/timeline/captions/social in Git
episodes/*/audio/
episodes/*/exports/*.mp4
episodes/*/thumbnails/*.png
episodes/*/thumbnails/*.jpg
episodes/*/publishing/.lock
episodes/*/.lock
episodes/*/delivery.*/
episodes/*/publishing/log.jsonl
# Resumable upload session URLs (allow upload without login): never in Git
episodes/*/publishing/upload-state.json

# Episode audio copied for rendering (voice clones)
public/audio/episodes/

# Delivery package: rebuilt from current sources by `npm run episode:delivery` (build output, not in Git)
episodes/*/delivery/

# Office Comedy Studio: built frontend and runtime data (background job records)
studio/dist/
runtime/
