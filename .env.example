# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env. Không ghi key vào code hoặc log.

# Dịch vụ giọng đọc tiếng Việt (TTS) — sẽ chọn ở bước sau
TTS_PROVIDER=
TTS_API_KEY=

# Dịch vụ nhận dạng giọng nói để tạo phụ đề (nếu dùng dịch vụ ngoài)
STT_API_KEY=

# Số luồng render (máy hiện tại: 2-3)
REMOTION_CONCURRENCY=2
