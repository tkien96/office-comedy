# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env. Không ghi key vào code hoặc log.

# Giọng đọc tiếng Việt (TTS)
TTS_PROVIDER=elevenlabs
# Tạo key tại https://elevenlabs.io/app/settings/api-keys
# Nên giới hạn quyền: Text to Speech + Voices (đọc) + User (đọc), đặt hạn mức credit.
ELEVENLABS_API_KEY=

# Dịch vụ nhận dạng giọng nói để tạo phụ đề (nếu dùng dịch vụ ngoài)
STT_API_KEY=

# Số luồng render (máy hiện tại: 2-3)
REMOTION_CONCURRENCY=2

# Đăng bài (chỉ tên biến; giá trị đặt trong .env, không commit)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Claude API (Office Comedy Studio: viết/sửa kịch bản). Chỉ đặt giá trị trong .env, không commit.
# Gọi API tính phí theo tài khoản Claude Console, tách với gói Claude Code.
ANTHROPIC_API_KEY=
